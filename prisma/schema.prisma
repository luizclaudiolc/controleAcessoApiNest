generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DonoTipo {
  MORADOR
  VISITANTE
}

enum TipoRegistro {
  ENTRADA
  SAIDA
}

enum Roles {
  ADMIN
  PORTEIRO
}

model Morador {
  id              String    @id @default(uuid())
  nome            String
  bloco           String?
  apartamento     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deleteAt        DateTime?
  carros          Carro[]
  criadoPorId     String?
  criadoPor       Porteiro? @relation("MoradorCriacao", fields: [criadoPorId], references: [id])
  atualizadoPorId String?
  atualizadoPor   Porteiro? @relation("MoradorAtualizacao", fields: [atualizadoPorId], references: [id])
}

model Visitante {
  id              String     @id @default(uuid())
  nome            String
  documento       String?    @unique
  telefone        String?
  descricao       String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deleteAt        DateTime?
  registros       Registro[]
  carros          Carro[]
  criadoPorId     String?
  criadoPor       Porteiro?  @relation("VisitanteCriacao", fields: [criadoPorId], references: [id])
  atualizadoPorId String?
  atualizadoPor   Porteiro?  @relation("VisitanteAtualizacao", fields: [atualizadoPorId], references: [id])
  porteiroId      String?
  porteiro        Porteiro?  @relation("RegistrosVisitante", fields: [porteiroId], references: [id])
}

model Carro {
  id          String     @id @default(uuid())
  placa       String     @unique
  modelo      String?
  cor         String?
  donoId      String
  donoTipo    DonoTipo
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deleteAt    DateTime?
  registros   Registro[]
  morador     Morador?   @relation(fields: [moradorId], references: [id])
  moradorId   String?
  visitante   Visitante? @relation(fields: [visitanteId], references: [id])
  visitanteId String?

  @@index([donoTipo, donoId])
}

model Registro {
  id              String       @id @default(uuid())
  tipo            TipoRegistro
  carroId         String?
  carro           Carro?       @relation(fields: [carroId], references: [id], onDelete: SetNull)
  placa           String?
  visitanteId     String?
  visitante       Visitante?   @relation(fields: [visitanteId], references: [id], onDelete: SetNull)
  dataHoraEntrada DateTime
  dataHoraSaida   DateTime?
  porteiroId      String?
  porteiro        Porteiro?    @relation(fields: [porteiroId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([visitanteId, dataHoraSaida])
  @@index([placa])
  @@index([tipo])
  @@index([porteiroId])
  @@index([dataHoraEntrada])
}

model Porteiro {
  id                    String      @id @default(uuid())
  nome                  String
  matricula             String      @unique
  senha                 String
  roles                 Roles[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deleteAt              DateTime?
  registros             Registro[]
  visitantesRegistrados Visitante[] @relation("RegistrosVisitante")
  visitantesCriados     Visitante[] @relation("VisitanteCriacao")
  visitantesAtualizados Visitante[] @relation("VisitanteAtualizacao")
  moradores             Morador[]   @relation("MoradorCriacao")
  moradoresAtualizados  Morador[]   @relation("MoradorAtualizacao")
}

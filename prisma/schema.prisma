// ...existing code...
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DonoTipo {
  MORADOR
  VISITANTE
}

enum TipoRegistro {
  ENTRADA
  SAIDA
}

enum Roles {
  ADMIN
  PORTEIRO
}

model Morador {
  id          Int       @id @default(autoincrement())
  nome        String
  bloco       String?
  apartamento String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deleteAt    DateTime?
}

model Visitante {
  id                   Int        @id @default(autoincrement())
  nome                 String
  documento            String?    @unique
  telefone             String?
  descricao            String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  deleteAt             DateTime?
  registros            Registro[]
  ultimaAtualizacaoPor Int?
  porteiroAtualizacao  Porteiro?  @relation("VisitanteAtualizacoes", fields: [ultimaAtualizacaoPor], references: [id])
  porteiro             Porteiro?  @relation(fields: [porteiroId], references: [id])
  porteiroId           Int?
}

model Carro {
  id     Int     @id @default(autoincrement())
  placa  String  @unique
  modelo String?
  cor    String?

  donoId   Int
  donoTipo DonoTipo

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deleteAt  DateTime?
  registros Registro[]

  @@index([donoTipo, donoId])
}

model Registro {
  id              Int          @id @default(autoincrement())
  tipo            TipoRegistro
  carroId         Int?
  carro           Carro?       @relation(fields: [carroId], references: [id], onDelete: SetNull)
  placa           String?
  visitanteId     Int?
  visitante       Visitante?   @relation(fields: [visitanteId], references: [id], onDelete: SetNull)
  dataHoraEntrada DateTime
  dataHoraSaida   DateTime?
  porteiroId      Int?
  porteiro        Porteiro?    @relation(fields: [porteiroId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([visitanteId, dataHoraSaida])
  @@index([placa])
  @@index([tipo])
  @@index([porteiroId])
  @@index([dataHoraEntrada])
}

model Porteiro {
  id                    Int         @id @default(autoincrement())
  nome                  String
  matricula             String      @unique
  senha                 String
  roles                 Roles[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deleteAt              DateTime?
  registros             Registro[]
  visitantes            Visitante[]
  visitantesAtualizados Visitante[] @relation("VisitanteAtualizacoes")
}

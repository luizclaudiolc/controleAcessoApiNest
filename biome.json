{
  "linter": {
    "enabled": true,

    "rules": {
      "suspicious": {
        "useImportType": "off"
      },

      "style": {
        "noUnusedTemplateLiteral": "off",
        "useImportType": {
          "options": {
            "style": "inlineType"
          }
        }
      }
    }
  }
}
